# Copy to benchmark/.env and fill in the keys you want to benchmark.
# The production Edge Functions use 3 Groq keys and 5 Gemini keys; the harness
# uses them round-robin only to avoid rate limits. A single key also works.

GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
